{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/permit-intel/schema/contractor_v1.json",
  "title": "Contractor license / insurance / bond record v1 (Actor #2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "source", "contractor", "insurance", "bond", "alerts", "is_expiring_alert"],
  "definitions": {
    "nstr": {"type": ["string", "null"]},
    "nnum": {"type": ["number", "null"]},
    "nint": {"type": ["integer", "null"]},
    "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "contractor"},
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "state", "dataset_ids", "source_url", "fetched_at"],
      "properties": {
        "source_id": {"const": "wa_lni"},
        "state": {"const": "WA"},
        "dataset_ids": {"type": "array", "items": {"type": "string"}},
        "source_url": {"type": "string"},
        "fetched_at": {"type": "string"}
      }
    },
    "contractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_name", "license_number", "license_state", "license_type", "license_status", "license_expiration_date", "phone_e164", "address", "specialties"],
      "properties": {
        "company_name": {"$ref": "#/definitions/nstr"},
        "license_number": {"type": "string"},
        "license_state": {"const": "WA"},
        "license_type": {"$ref": "#/definitions/nstr"},
        "license_status": {"$ref": "#/definitions/nstr"},
        "license_effective_date": {"$ref": "#/definitions/date"},
        "license_expiration_date": {"$ref": "#/definitions/date"},
        "license_suspend_date": {"$ref": "#/definitions/date"},
        "ubi": {"$ref": "#/definitions/nstr"},
        "business_type": {"$ref": "#/definitions/nstr"},
        "specialties": {"type": "array", "items": {"type": "string"}},
        "phone_e164": {"type": ["string", "null"], "pattern": "^\\+1[2-9]\\d{2}[2-9]\\d{6}$"},
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line1", "city", "state", "zip"],
          "properties": {
            "line1": {"$ref": "#/definitions/nstr"},
            "city": {"$ref": "#/definitions/nstr"},
            "state": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
            "zip": {"type": ["string", "null"], "pattern": "^\\d{5}$"}
          }
        }
      }
    },
    "insurance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "company": {"$ref": "#/definitions/nstr"},
        "policy_no": {"$ref": "#/definitions/nstr"},
        "amount_usd": {"$ref": "#/definitions/nnum"},
        "effective_date": {"$ref": "#/definitions/date"},
        "expiration_date": {"$ref": "#/definitions/date"},
        "agency_name": {"$ref": "#/definitions/nstr"},
        "days_to_expiration": {"$ref": "#/definitions/nint"}
      }
    },
    "bond": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "surety": {"$ref": "#/definitions/nstr"},
        "bond_account_id": {"$ref": "#/definitions/nstr"},
        "amount_usd": {"$ref": "#/definitions/nnum"},
        "effective_date": {"$ref": "#/definitions/date"},
        "cancel_date": {"$ref": "#/definitions/date"},
        "days_to_cancel": {"$ref": "#/definitions/nint"}
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "date", "days_until"],
        "properties": {
          "type": {"enum": ["insurance_expiring", "bond_cancelling", "license_expiring"]},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "days_until": {"type": "integer", "minimum": 0}
        }
      }
    },
    "is_expiring_alert": {"type": "boolean"}
  }
}
