{
  "name": "Google Ads Transparency Center Competitor & Lead Qualifier -> Sheets + Slack",
  "nodes": [
    {
      "parameters": {
        "content": "## Google Ads Transparency Center Scraper \u2014 Advertiser Leads\nQualifies domains to check if they run Google Ads and extracts active ad creatives via `rickyz1x/google-ads-transparency-advertiser-leads`.",
        "height": 240,
        "width": 500
      },
      "id": "note-ads-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "sched-ads-1",
      "name": "Weekly Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/rickyz1x~google-ads-transparency-advertiser-leads/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.APIFY_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"queries\": [\"hubspot.com\", \"shopify.com\"],\n  \"maxCreativesPerQuery\": 15,\n  \"region\": \"US\",\n  \"includeAdvertiserSummary\": true\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "http-ads-1",
      "name": "Run Apify Google Ads Transparency Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        400
      ]
    }
  ],
  "connections": {
    "Weekly Monday 09:00": {
      "main": [
        [
          {
            "node": "Run Apify Google Ads Transparency Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
