    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build ONE weekly Slack digest: total expiring contractors + top 10 most urgent renewals.\nconst rows = $('Flatten alert columns').all().map(i => i.json);\nconst total = rows.length;\nif (total === 0) {\n  return [];\n}\nconst num = v => (v === '' || v === null || v === undefined || isNaN(Number(v))) ? 999 : Number(v);\nconst top = [...rows]\n  .sort((a, b) => num(a['Days Left']) - num(b['Days Left']))\n  .slice(0, 10)\n  .map((r, i) => `${i + 1}. ${r['Contractor'] || 'unknown'} (${r['City'] || 'WA'}) | ${r['Alert Type']} in ${r['Days Left']}d (${r['Earliest Expiry']}) | Insurer: ${r['Insurer'] || 'n/a'} | ${r['Phone']}`);\nconst today = new Date().toISOString().slice(0, 10);\nconst lines = [\n  `*${total} contractor insurance/bond/license expiration alert(s)* (${today})`,\n  ...top,\n];\nif (total > 10) lines.push(`...and ${total - 10} more in the Google Sheet.`);\nreturn [{ json: { text: lines.join('\\n'), total } }];\n"
      },
