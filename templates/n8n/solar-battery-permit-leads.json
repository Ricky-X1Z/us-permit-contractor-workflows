    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build ONE Slack message: total count + top 10 lines (largest solar systems first).\nconst rows = $('Flatten columns').all().map(i => i.json);\nconst total = rows.length;\nif (total === 0) {\n  return [];\n}\nconst num = v => (v === '' || v === null || v === undefined || isNaN(Number(v))) ? 0 : Number(v);\nconst top = [...rows]\n  .sort((a, b) => num(b['Solar kW']) - num(a['Solar kW']))\n  .slice(0, 10)\n  .map((r, i) => {\n    const specs = [\n      r['Solar kW'] ? `${r['Solar kW']} kW PV` : '',\n      r['Battery kWh'] ? `${r['Battery kWh']} kWh battery` : '',\n    ].filter(Boolean).join(', ');\n    return `${i + 1}. ${r['Issued'] || 'n/a'} | ${r['City']}, ${r['State']} | ${r['Categories']}${specs ? ' (' + specs + ')' : ''} | ${r['Contractor'] || 'unknown'} | ${r['Phone']}`;\n  });\nconst today = new Date().toISOString().slice(0, 10);\nconst lines = [\n  `*${total} new solar/battery permit(s) with a contractor phone* (${today})`,\n  ...top,\n];\nif (total > 10) lines.push(`...and ${total - 10} more in the Google Sheet.`);\nreturn [{ json: { text: lines.join('\\n'), total } }];\n"
      },
